// Copy this file to Secrets.xcconfig and paste the token configured in Render.
// Secrets.xcconfig is ignored by Git.
BACKEND_API_TOKEN = paste-your-app-api-token-here

// For local development on a physical iPhone, uncomment this and use the
// Mac's local-network address. Simulator development can keep localhost.
// LOCAL_BACKEND_HOST = 192.168.1.10
